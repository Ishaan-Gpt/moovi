node_modules/
.next/
.next-preview/
out/
dist/
.env*
!.env.example
*.log
.DS_Store
.vercel

# raw chat export: local only (it can contain tool output from the machine)
docs/context/raw/

# heavy 3D work files; ship optimised .glb only
assets/character/work/
*.blend1

# studio: MotionEasy engine bundle, fonts, sounds and music beds (copied by `pnpm sync:motioneasy`)
apps/studio/public/engine/
apps/studio/public/media/
# studio: style preview loops (cut from the owner's renders) and Style 1 brand assets (copied by `pnpm sync:styles`)
apps/studio/public/styles/
apps/studio/public/me/
# the local bench's working folders (voice, timings, mixes)
.bench/

# engine + studio runtime data: users' uploads, runs, renders, vendored engine/SFX/music, FalkorDB backups (local only)
/data/*
# except the reference clones' code and parts lists. The reference video, voice and frames stay local (they are not
# ours); fetch them with scripts/ref-intake.ts <id> <url>
!/data/refs/
/data/refs/*/*
!/data/refs/*/clone-motion/
!/data/refs/*/parts.json
/data/refs/*/clone-motion/*.mp3
/data/refs/*/clone-motion/*.mp4

# extra Next build folders (second dev servers)
.next-*/

# TypeScript incremental build caches
*.tsbuildinfo

# the AI usage log stays local (Ishaan, 2026-10-18)
AI_USAGE.md
