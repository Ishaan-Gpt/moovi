{
  "name": "moovi",
  "private": true,
  "version": "0.1.0",
  "description": "Moovi: hire an AI video director who leads a visible crew of agents.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:playground": "pnpm --filter @moovi/playground dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:studio": "pnpm --filter @moovi/studio dev",
    "dev:landing": "pnpm --filter @moovi/landing dev",
    "graph:seed": "pnpm --filter @moovi/graph seed",
    "graph:reset": "pnpm --filter @moovi/engine reset",
    "falkordb": "docker run -d --name moovi-falkordb -p 6380:6379 -p 3001:3000 -v moovi-falkordb:/var/lib/falkordb/data falkordb/falkordb:6.0.2",
    "dev:engine": "pnpm --filter @moovi/engine worker",
    "engine:run": "pnpm --filter @moovi/engine run",
    "test": "pnpm -r --if-present test",
    "s1:make": "pnpm --filter @moovi/engine s1make",
    "s1:fast": "pnpm --filter @moovi/engine s1fast"
  }
}
