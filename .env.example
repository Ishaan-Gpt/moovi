# Moovi: copy to .env.local (git-ignored) and fill in. Nothing here is a real secret.

# Moovi's memory (FalkorDB in Docker: `pnpm falkordb`). Use 127.0.0.1, not localhost, on Windows.
FALKORDB_URL=falkor://127.0.0.1:6380

# Encrypts every user's stored model key (any long random string). Keep it secret; changing it forgets saved keys.
MOOVI_SECRET=

# Bring your own model: required (default) asks every user for their own API key in the studio.
# optional lets a user without a key run on the server's own model below.
MOOVI_BYOK=required

# The server's own model, for the terminal scripts and (with MOOVI_BYOK=optional) keyless users.
# claude-code = this machine's Claude Code login; http = an API key below (the first one set is used).
MOOVI_RUNTIME=http
# MOOVI_PROVIDER=groq
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Optional per-tier models (else each provider's defaults, checked against its live model list):
# MOOVI_MODEL_DIRECTOR=
# MOOVI_MODEL_CREW=
# MOOVI_MODEL_FAST=


# Chrome or Chromium for reading sites, drawing and contact sheets (default: the installed Google Chrome).
# MOOVI_CHROME_PATH=/usr/bin/chromium
# ffmpeg, when it is not on the PATH
# FFMPEG=/usr/bin/ffmpeg
