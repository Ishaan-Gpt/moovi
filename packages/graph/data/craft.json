 "components": [
  {
   "id": "hook-strike",
   "name": "Strike & Swap",
   "category": "hooks",
   "description": "A question everyone recognises, a marker strikes out the painful part, and the new answer slams in beneath it in serif. A pattern interrupt in under three seconds.",
   "notes": "Open with it. The struck words must appear exactly in the line.",
   "duration": 4.2,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "hook",
     "rank": 0
    }
   ]
  },
  {
   "id": "stat-trio",
   "name": "Stat Trio",
   "category": "proof",
   "description": "Three proof points as cards that land one after another, numbers counting as they arrive. The hero card is set in ink.",
   "notes": "Write stats as 'number|label', e.g. '30+|caption looks'. Real numbers only.",
   "duration": 4.15,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "proof",
     "rank": 0
    }
   ]
  },
  {
   "id": "checklist",
   "name": "Checklist",
   "category": "proof",
   "description": "Claims tick off one by one: each check draws itself, the line rises beside it, and a soft tick keeps time. Clean, confident proof.",
   "notes": "Only true claims. 4–6 short items read best.",
   "duration": 4.32,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "list",
     "rank": 1
    },
    {
     "id": "proof",
     "rank": 2
    }
   ]
  },
  {
   "id": "four-steps",
   "name": "Four Steps",
   "category": "lists",
   "description": "A how-it-works beat: a big odometer rolls 01 → 04 while each step's title and detail swap in, and a progress rail fills underneath.",
   "notes": "Write steps as 'Title|detail'. 3–5 steps.",
   "duration": 7,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "list",
     "rank": 0
    }
   ]
  },
  {
   "id": "now-live",
   "name": "Now Live Stamp",
   "category": "launch",
   "description": "A rubber-stamp badge slams onto the frame with a tilt and an ink ripple, then the headline and the link settle in under it.",
   "notes": "Announcements: launches, new features, price drops. One stamp per post.",
   "duration": 4.4,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "cta",
     "rank": 1
    }
   ]
  },
  {
   "id": "beat-slam",
   "name": "Beat Slam",
   "category": "kinetic-type",
   "description": "One word per beat, slammed into frame from the camera with a light flare and a micro kick. Accent words land in serif italic.",
   "notes": "Best as a hook in the first 2 seconds. Don't follow it with another slam; cut to media.",
   "duration": 2.85,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "hook",
     "rank": 1
    }
   ]
  },
  {
   "id": "kinetic-stack",
   "name": "Kinetic Stack",
   "category": "kinetic-type",
   "description": "Poster typography: every line is set to the full width of the frame, so short words go huge. Lines slam in from alternating sides on the beat with real motion blur: solid, outline, then a colour bar.",
   "notes": "Fills the frame with type, so it needs no backdrop. 2–5 short lines; one word per line hits hardest. Set the BPM to the track.",
   "duration": 3.24,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "hook",
     "rank": 2
    }
   ]
  },
  {
   "id": "type-marquee",
   "name": "Type Marquee",
   "category": "kinetic-type",
   "description": "The whole frame is type: rows of outlined words scroll against each other while the message flies in on the middle row, lands dead centre and gets a colour band behind it.",
   "notes": "A loud opener or chapter card. The echo rows repeat a word (the product, the topic); keep the message to 1–3 words.",
   "duration": 3.9,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "hook",
     "rank": 4
    }
   ]
  },
  {
   "id": "char-cascade",
   "name": "Char Cascade",
   "category": "kinetic-type",
   "description": "Every letter arrives on its own spring, a couple of frames after the last, never in lockstep. Accent words pop a little bigger, then a hairline draws underneath.",
   "notes": "The per-character stagger that makes type feel hand-animated. Rise for calm lines, Drop for punch, Scatter for a playful hook. Don't follow it with another per-letter reveal.",
   "duration": 3.05,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "hook",
     "rank": 3
    },
    {
     "id": "body",
     "rank": 2
    }
   ]
  },
  {
   "id": "image-type",
   "name": "Image Type",
   "category": "kinetic-type",
   "description": "One huge word with your footage playing inside the letters. Then the word becomes a window: it opens out until the footage is the whole frame. Type that turns into the next shot.",
   "notes": "Use a short, wide word (4–7 letters) and footage with colour and movement. With Open on, it hands over to the footage: follow it with a cut, not another reveal.",
   "duration": 4.7,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
   "slots": [
    {
     "id": "footage",
     "rank": 2
    }
   ]
  },
  {
   "id": "word-rotator",
   "name": "Word Rotator",
   "category": "kinetic-type",
   "description": "A fixed line and a rotating word that rolls on a 3D drum. The slot behind it resizes with a spring for every new word.",
   "notes": "Great for 'X for Y' value props. Keep words short (one or two words) and 3–6 of them.",
   "duration": 5.15,
   "formats": [
    "vertical",
    "portrait",
    "square",
    "landscape"
   ],
