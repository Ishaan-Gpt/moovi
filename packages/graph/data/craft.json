 "transitions": [
  {
   "id": "whip",
   "name": "Whip pan",
   "description": "A fast camera whip with real directional motion blur. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "zoom",
   "name": "Zoom through",
   "description": "The camera flies into the shot and out of the next one. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "push",
   "name": "Push up",
   "description": "The next shot pushes the current one up and out, with motion blur. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "slide",
   "name": "Card slide",
   "description": "The next shot slides up over the current one like a card on a stack. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "match",
   "name": "Match grow",
   "description": "The next shot appears as a card inside this one and grows until it is the frame. The scene becomes the next scene. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "recede",
   "name": "Recede",
   "description": "This shot shrinks into a card and slides away, revealing the next one already pushing in behind it. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "iris",
   "name": "Iris",
   "description": "A soft circle opens from the centre onto the next shot. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "wipe",
   "name": "Light wipe",
   "description": "A diagonal wipe led by a soft band of light. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "shutter",
   "name": "Shutter slices",
   "description": "Horizontal slices slide across in alternating directions. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "flash",
   "name": "Light flash",
   "description": "A bloom of light that hides the cut. One per video. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "blur",
   "name": "Blur dissolve",
   "description": "Out of focus, into focus. Soft and calm. Drop it between any two clips in a post.",
   "signature": true
  },
  {
   "id": "cut",
   "name": "Hard cut",
   "description": "No transition. The cleanest cut there is. Drop it between any two clips in a post.",
   "signature": false
  }
 ],
