{
  "name": "@moovi/engine",
  "version": "0.1.0",
  "private": true,
  "description": "The engine: a graph-backed task scheduler, the crew's agents (each a tool loop with its own done-check), the workers (voice, render, sound) and the event bus the studio watches.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bus": "./src/bus.ts",
    "./events": "./src/events.ts",
    "./commands": "./src/commands.ts",
    "./styles": "./src/styles/index.ts",
    "./styles/serve": "./src/styles/serve.ts",
    "./runtime": "./src/runtime/index.ts",
    "./keys": "./src/keys.ts",
    "./brain": "./src/brain.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --env-file=test/graph-optional.env --test test/*.test.ts",
    "reset": "tsx --env-file-if-exists=../../.env.local scripts/reset.ts",
    "worker": "tsx --env-file-if-exists=../../.env.local scripts/worker.ts",
    "run": "tsx --env-file-if-exists=../../.env.local scripts/run.ts",
    "s1make": "tsx --env-file-if-exists=../../.env.local scripts/s1make.ts",
    "s1fast": "tsx --env-file-if-exists=../../.env.local scripts/s1fast.ts",
    "s1preview": "tsx scripts/s1preview.ts",
    "s1url": "tsx --env-file-if-exists=../../.env.local scripts/s1url.ts",
    "s4": "tsx --env-file-if-exists=../../.env.local scripts/s4.ts",
    "s5": "tsx --env-file-if-exists=../../.env.local scripts/s5.ts",
    "darkvox": "tsx --env-file-if-exists=../../.env.local scripts/darkvox.ts",
    "anatomy": "tsx --env-file-if-exists=../../.env.local scripts/anatomy.ts",
    "style-bench": "tsx --env-file-if-exists=../../.env.local scripts/style-bench.ts",
    "voices": "tsx --env-file-if-exists=../../.env.local scripts/voices.ts",
    "library": "tsx --env-file-if-exists=../../.env.local scripts/library.ts",
    "demo:graph-stop": "tsx --env-file-if-exists=../../.env.local scripts/demo-graph-stop.ts",
    "sounds": "tsx --env-file-if-exists=../../.env.local scripts/sounds.ts",
    "reference": "tsx --env-file-if-exists=../../.env.local scripts/reference.ts",
    "combined": "tsx --env-file-if-exists=../../.env.local scripts/combined.ts",
    "launch": "tsx --env-file-if-exists=../../.env.local scripts/launch.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@huggingface/transformers": "4.3.1",
    "@moovi/brand": "workspace:*",
    "@moovi/graph": "workspace:*",
    "@moovi/library": "workspace:*",
    "@moovi/skills": "workspace:*",
    "captionseasy": "0.1.1",
    "maplibre-gl": "5.6.0",
    "playwright-core": "1.56.1",
    "redis": "5.12.1",
    "three": "0.170.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
