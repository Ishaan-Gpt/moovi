{
 "$id": "https://moovi.dev/schema/edl-0.1.json",
 "title": "Moovi EDL v0",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "version": {
   "type": "string",
   "description": "schema version, \"0.1\" for v0"
  },
  "style_id": {
   "type": "string",
   "description": "atlas, night-desk, handmade, crimson-cutout, brand-promo, studio-minimal, or rough"
  },
  "style_variant": {
   "description": "Night Desk: \"A\" (split explainer) or \"B\" (story)",
   "type": "string"
  },
  "seed": {
   "type": "integer",
   "minimum": -9007199254740991,
   "maximum": 9007199254740991
  },
  "rules_version": {
   "description": "version of the style laws that built this EDL",
   "type": "string"
  },
  "source": {
   "type": "object",
   "properties": {
    "file": {
     "type": "string",
     "description": "the source clip, relative to the EDL file"
    },
    "id": {
     "description": "upload id or sha256 of the clip",
     "type": "string"
    },
    "duration": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "w": {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991
    },
    "h": {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991
    },
    "fps": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   },
   "required": [
    "file",
    "duration",
    "w",
    "h",
    "fps"
   ],
   "additionalProperties": false
  },
  "output": {
   "type": "object",
   "properties": {
    "w": {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991
    },
    "h": {
     "type": "integer",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991
    },
    "fps": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "aspect": {
     "description": "9:16, 1:1, 16:9, 4:5",
     "type": "string"
    }
   },
   "required": [
    "w",
    "h",
    "fps"
   ],
   "additionalProperties": false
  },
  "palette": {
   "type": "object",
   "properties": {
    "ink": {
     "type": "string"
    },
    "paper": {
     "type": "string"
    },
    "accent": {
     "type": "string"
    },
    "accent2": {
     "type": "string"
    },
    "deep": {
     "type": "string"
    },
    "pop": {
     "type": "string"
    }
   },
   "required": [
    "ink",
    "paper",
    "accent",
    "accent2",
    "deep",
    "pop"
   ],
   "additionalProperties": false
  },
  "caption_style_id": {
   "type": "string",
   "description": "R8 caption style id (with or without \"caption:\")"
  },
  "words": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "src_t0": {
      "type": "number",
      "minimum": 0
     },
     "src_t1": {
      "type": "number",
      "minimum": 0
     },
     "text": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "connector",
       "key",
       "number",
       "title"
      ]
     },
     "line_id": {
      "description": "sentence or line index",
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
     },
     "speaker": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
     },
     "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "src_t0",
     "src_t1",
     "text"
    ],
    "additionalProperties": false
   }
  },
  "shots": {
   "minItems": 1,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t_in": {
      "type": "number",
      "minimum": 0
     },
     "t_out": {
      "type": "number",
      "minimum": 0
     },
     "src_in": {
      "type": "number",
      "minimum": 0
     },
     "src_out": {
      "type": "number",
      "minimum": 0
     },
     "layout": {
      "type": "string",
      "enum": [
       "full",
       "split_top",
       "split_bottom",
       "card",
       "pip",
       "full_insert"
      ]
     },
     "framing": {
      "type": "object",
      "properties": {
       "scale": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "cx": {
        "type": "number",
        "minimum": -0.5,
        "maximum": 1.5
       },
       "cy": {
        "type": "number",
        "minimum": -0.5,
        "maximum": 1.5
       },
       "rot": {
        "type": "number"
       }
      },
      "required": [
       "scale",
       "cx",
       "cy"
      ],
      "additionalProperties": false
     },
     "zoom": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "t": {
         "type": "number",
         "minimum": 0
        },
        "scale": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "cx": {
         "type": "number",
         "minimum": -0.5,
         "maximum": 1.5
        },
        "cy": {
         "type": "number",
         "minimum": -0.5,
         "maximum": 1.5
        },
        "ease": {
         "type": "string",
         "enum": [
          "out",
          "inout",
          "cut"
         ]
        },
        "dur": {
         "type": "number",
         "minimum": 0
        },
        "rule_id": {
         "type": "string",
         "minLength": 1,
         "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
        }
       },
       "required": [
        "t",
        "scale",
        "cx",
        "cy"
       ],
       "additionalProperties": false
      }
     },
     "bg": {
      "type": "object",
      "properties": {
       "mode": {
        "type": "string",
        "enum": [
         "original",
         "matte_fill",
         "matte_texture"
        ]
       },
       "asset_ref": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
        "description": "an R7 library Asset id"
       },
       "role": {
        "type": "string",
        "enum": [
         "ink",
         "paper",
         "accent",
         "accent2",
         "deep",
         "pop"
        ]
       }
      },
      "required": [
       "mode"
      ],
      "additionalProperties": false
     },
     "matte": {
      "description": "cut the person out (person mask)",
      "type": "boolean"
     },
     "mono": {
      "type": "boolean"
     },
     "grade_id": {
      "type": "string"
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t_in",
     "t_out",
     "src_in",
     "src_out"
    ],
    "additionalProperties": false
   }
  },
  "removed": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "src_in": {
      "type": "number",
      "minimum": 0
     },
     "src_out": {
      "type": "number",
      "minimum": 0
     },
     "reason": {
      "type": "string",
      "enum": [
       "pause_trim",
       "filler",
       "slate",
       "retake",
       "pre_roll",
       "tail",
       "silence"
      ]
     },
     "text": {
      "description": "the words removed, if any",
      "type": "string"
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "src_in",
     "src_out",
     "reason",
     "rule_id"
    ],
    "additionalProperties": false
   }
  },
  "cuts": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t": {
      "type": "number",
      "minimum": 0
     },
     "type": {
      "type": "string",
      "enum": [
       "hard",
       "jump",
       "punch",
       "flash",
       "glitch",
       "blur_zoom",
       "zoom_through",
       "whip",
       "tile_grid",
       "paper_tear",
       "circle_wipe",
       "slide",
       "device_pullback"
      ]
     },
     "dur": {
      "type": "number",
      "minimum": 0
     },
     "trigger": {
      "type": "string",
      "enum": [
       "sentence",
       "pause",
       "filler",
       "keyword",
       "number",
       "beat",
       "insert",
       "hold_max"
      ]
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t",
     "type",
     "trigger",
     "rule_id"
    ],
    "additionalProperties": false
   }
  },
  "captions": {
   "description": "explicit caption events; when absent the player chunks words by the caption style",
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t0": {
      "type": "number",
      "minimum": 0
     },
     "t1": {
      "type": "number",
      "minimum": 0
     },
     "word_idx": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "tier": {
      "type": "string",
      "enum": [
       "connector",
       "key",
       "title"
      ]
     },
     "style_id": {
      "type": "string"
     },
     "case": {
      "type": "string",
      "enum": [
       "upper",
       "title",
       "as-is",
       "lower"
      ]
     },
     "size": {
      "type": "string",
      "enum": [
       "S",
       "M",
       "L",
       "XL",
       "XXL"
      ]
     },
     "font_role": {
      "type": "string"
     },
     "position": {
      "type": "string",
      "enum": [
       "chest",
       "left_of_head",
       "top",
       "lower",
       "center",
       "behind_subject",
       "face-safe"
      ]
     },
     "path": {
      "type": "string",
      "enum": [
       "line",
       "arc",
       "vertical"
      ]
     },
     "rotation": {
      "type": "number"
     },
     "entry": {
      "type": "string"
     },
     "exit": {
      "type": "string"
     },
     "highlight_idx": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": -9007199254740991,
       "maximum": 9007199254740991
      }
     },
     "colour_role": {
      "type": "string",
      "enum": [
       "ink",
       "paper",
       "accent",
       "accent2",
       "deep",
       "pop"
      ]
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t0",
     "t1",
     "word_idx",
     "rule_id"
    ],
    "additionalProperties": false
   }
  },
  "inserts": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t0": {
      "type": "number",
      "minimum": 0
     },
     "t1": {
      "type": "number",
      "minimum": 0
     },
     "kind": {
      "type": "string",
      "enum": [
       "broll",
       "panel",
       "poster",
       "ui",
       "checklist",
       "card",
       "title",
       "timer",
       "number",
       "map",
       "phone",
       "object3d",
       "photo"
      ]
     },
     "frame": {
      "type": "string",
      "enum": [
       "full",
       "top_half",
       "card_box",
       "beside_head"
      ]
     },
     "label": {
      "type": "string"
     },
     "asset_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
      "description": "an R7 library Asset id"
     },
     "need": {
      "description": "the R4b need this insert serves, e.g. \"show_number\"",
      "type": "string"
     },
     "query": {
      "description": "stock search words, resolved to a file at render time",
      "type": "string"
     },
     "side": {
      "type": "string",
      "enum": [
       "left",
       "right"
      ]
     },
     "enter": {
      "type": "string"
     },
     "exit": {
      "type": "string"
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t0",
     "t1",
     "kind",
     "frame"
    ],
    "additionalProperties": false
   }
  },
  "overlays": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t0": {
      "type": "number",
      "minimum": 0
     },
     "t1": {
      "type": "number",
      "minimum": 0
     },
     "kind": {
      "type": "string",
      "enum": [
       "halo",
       "sunburst",
       "doodle",
       "outline_stroke",
       "header_strip",
       "glow_trace",
       "grain",
       "vignette",
       "light_leak",
       "title_behind",
       "face_label"
      ]
     },
     "asset_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
      "description": "an R7 library Asset id"
     },
     "text": {
      "type": "string"
     },
     "params": {
      "type": "object",
      "propertyNames": {
       "type": "string"
      },
      "additionalProperties": {}
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t0",
     "t1",
     "kind",
     "rule_id"
    ],
    "additionalProperties": false
   }
  },
  "sfx": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t": {
      "type": "number",
      "minimum": 0
     },
     "asset_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
      "description": "an R7 library Asset id"
     },
     "event": {
      "type": "string",
      "enum": [
       "cut",
       "insert_in",
       "title_in",
       "flash",
       "stamp",
       "ui_click",
       "number_hit",
       "whoosh",
       "riser",
       "end"
      ]
     },
     "gain_db": {
      "type": "number"
     },
     "rule_id": {
      "type": "string",
      "minLength": 1,
      "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
     }
    },
    "required": [
     "t",
     "asset_ref",
     "event",
     "rule_id"
    ],
    "additionalProperties": false
   }
  },
  "music": {
   "type": "object",
   "properties": {
    "asset_ref": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
     "description": "an R7 library Asset id"
    },
    "offset": {
     "description": "start point in the track, seconds",
     "type": "number",
     "minimum": 0
    },
    "bpm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "beats": {
     "description": "output seconds",
     "type": "array",
     "items": {
      "type": "number",
      "minimum": 0
     }
    },
    "gain_db": {
     "type": "number"
    },
    "duck": {
     "type": "object",
     "properties": {
      "db": {
       "type": "number"
      },
      "attack_ms": {
       "type": "number",
       "minimum": 0
      },
      "release_ms": {
       "type": "number",
       "minimum": 0
      }
     },
     "required": [
      "db",
      "attack_ms",
      "release_ms"
     ],
     "additionalProperties": false
    },
    "cut_on_beat": {
     "type": "boolean"
    },
    "end": {
     "type": "string",
     "enum": [
      "button",
      "fade",
      "cut"
     ]
    },
    "fade": {
     "type": "number",
     "minimum": 0
    },
    "credit": {
     "description": "the credit line a CC BY track needs",
     "type": "string"
    },
    "rule_id": {
     "type": "string",
     "minLength": 1,
     "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
    }
   },
   "required": [
    "asset_ref",
    "gain_db"
   ],
   "additionalProperties": false
  },
  "voice": {
   "type": "object",
   "properties": {
    "clean": {
     "type": "string",
     "enum": [
      "none",
      "arnndn",
      "afftdn"
     ]
    },
    "gain_db": {
     "type": "number"
    },
    "target_lufs": {
     "type": "number",
     "maximum": 0
    },
    "true_peak": {
     "type": "number",
     "maximum": 0
    }
   },
   "required": [
    "clean",
    "target_lufs",
    "true_peak"
   ],
   "additionalProperties": false
  },
  "end": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "cta_comment",
      "cta_pill",
      "logo",
      "name",
      "text"
     ]
    },
    "t0": {
     "type": "number",
     "minimum": 0
    },
    "title": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "asset_ref": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9][\\w.-]*$",
     "description": "an R7 library Asset id"
    },
    "rule_id": {
     "type": "string",
     "minLength": 1,
     "description": "the rule that made this decision, e.g. \"law.pause_trim\" or \"nightdesk.split_on_number\""
    }
   },
   "required": [
    "kind",
    "t0"
   ],
   "additionalProperties": false
  },
  "faces": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "src_t": {
      "type": "number",
      "minimum": 0
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "w": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "h": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "src_t",
     "x",
     "y",
     "w",
     "h"
    ],
    "additionalProperties": false,
    "description": "a face box in source time, as fractions of the source frame"
   }
  },
  "beats": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "t0": {
      "type": "number",
      "minimum": 0
     },
     "t1": {
      "type": "number",
      "minimum": 0
     },
     "word_idx": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0,
       "maximum": 9007199254740991
      }
     },
     "tag": {
      "type": "string",
      "enum": [
       "hook",
       "claim",
       "number",
       "list",
       "story",
       "quote",
       "name",
       "cta",
       "aside"
      ]
     },
     "need": {
      "type": "string"
     }
    },
    "required": [
     "t0",
     "t1",
     "word_idx",
     "tag"
    ],
    "additionalProperties": false,
    "description": "one model call tags the script; style rules map tags to inserts and cuts"
   }
  },
  "laws": {
   "description": "the shared-law numbers this EDL was built with",
   "type": "object",
   "properties": {
    "pause_max": {
     "type": "number",
     "minimum": 0
    },
    "pause_keep": {
     "type": "number",
     "minimum": 0
    },
    "hold_max": {
     "type": "number",
     "minimum": 0
    },
    "snap_ms": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "pause_max",
    "pause_keep",
    "hold_max",
    "snap_ms"
   ],
   "additionalProperties": false
  },
  "metrics": {
   "type": "object",
   "properties": {
    "duration": {
     "type": "number",
     "minimum": 0
    },
    "source_duration": {
     "type": "number",
     "minimum": 0
    },
    "changes_per_s": {
     "type": "number",
     "minimum": 0
    },
    "events_per_s": {
     "type": "number",
     "minimum": 0
    },
    "median_shot": {
     "type": "number",
     "minimum": 0
    },
    "max_hold": {
     "type": "number",
     "minimum": 0
    },
